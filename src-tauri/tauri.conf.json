{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stock Opportunity Lab",
  "version": "0.1.6",
  "identifier": "com.sleepdevil.stockopportunitylab",
  "build": {
    "beforeDevCommand": "npm run desktop:dev:services",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Stock Opportunity Lab",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 720,
        "center": true,
        "resizable": true,
        "fullscreen": false
      },
      {
        "label": "widget",
        "title": "今日机会",
        "url": "/desktop-widget",
        "width": 380,
        "height": 520,
        "minWidth": 320,
        "minHeight": 360,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "fullscreen": false,
        "shadow": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8765 https:; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "A-share screening and quantitative research desktop client",
    "longDescription": "Desktop companion for Stock Opportunity Lab with shared web features and local market-data services."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBMUQzRTNBMTA5MTVGOEIKUldTTFg1RVFPajRkdWkvY2xsTGwxL0JZbE5JQXBzMG9uL1RzZllkaG92TVp5UlNMWGF4bEVxMHMK",
      "endpoints": [
        "https://github.com/SleepDevil/stock-opportunity-lab/releases/latest/download/latest.json"
      ]
    }
  }
}
